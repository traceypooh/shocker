#!/usr/bin/env bash
# shocker — Docker implemented in around 500 lines of bash ⚡️
# Fork of bocker (github.com/p8952/bocker).  Updated for 2026.
#   - Docker Registry v2 API (v1 was shut down in 2023)
#   - cgroups v2 support with v1 fallback
#   - Improved UUID space & MAC address generation
#   - More robust container PID lookup

set -o errexit -o nounset -o pipefail; shopt -s nullglob

shocker_root="${SHOCKER_ROOT:-/var/shocker}"
# cgroups v1 legacy controllers (used only if cgroupsv2 is absent)
cgroups_v1='cpu,cpuacct,memory'

ORIG_ARGS=("$@")
[[ $# -gt 0 ]] && while [ "${1:0:2}" == '--' ]; do
  OPTION=${1:2}
  KEY=$(echo "${OPTION/=*/}" | tr a-z- A-Z_) # eg: --dest=x => SHOCKER_DEST=x
  [[ $OPTION =~ = ]] && declare "SHOCKER_${KEY}=${OPTION#*=}" \
                     || declare "SHOCKER_${KEY}=x"
  shift
done

# Rootless: when not real root, re-exec inside a new user + mount namespace where we *are* root
# (our uid => 0).  Enough for overlay, bind mounts, chroot & pid/ipc/uts namespaces.  Not for:
# cgroups (no limits), bridge networking (only --net=host|none), or image files owned by anyone
# but root (pull flattens ownership).  Container mounts live & die w/ this process.
# Images default to /var/shocker-rootless, made once by root for the one user who runs shocker
# (or set SHOCKER_ROOT; must not be on overlayfs or NFS).
if [[ $(id -u) != 0 ]]; then
  export SHOCKER_ROOTLESS=x
  export SHOCKER_ROOT="${SHOCKER_ROOT:-/var/shocker-rootless}"
  mkdir -p "$SHOCKER_ROOT" 2>/dev/null || true; [[ -w "$SHOCKER_ROOT" ]] || {
    echo "rootless: can't write $SHOCKER_ROOT -- as root: install -d -o $(id -un) -m700 $SHOCKER_ROOT" \
      "(or set SHOCKER_ROOT)" >&2; exit 1; }
  # Memory limit w/o root: run in a systemd user scope, a cgroup our user's systemd manager owns
  # (needs a user manager -- an ssh login session, or `loginctl enable-linger $USER`).
  # OOMPolicy=continue: like docker --memory, the kernel kills the biggest process (eg: ffmpeg),
  # not the whole scope -- so we survive to clean up.  No systemd user manager?  No limit.
  scope=()
  if [[ "${1:-}" == run && -n "${SHOCKER_MEM_LIMIT:-}" ]] && command -v systemd-run >/dev/null; then
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if systemd-run --user --scope -q true 2>/dev/null; then
      scope=(systemd-run --user --scope -q -p MemoryMax="${SHOCKER_MEM_LIMIT}M" -p OOMPolicy=continue --)
    else
      echo "rootless: no systemd user manager -- memory limit ${SHOCKER_MEM_LIMIT}M NOT enforced" >&2
    fi
  fi
  exec ${scope[@]+"${scope[@]}"} unshare --map-root-user --mount --propagation private -- \
    "$0" ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}
fi
ROOTLESS=0; [[ -n "${SHOCKER_ROOTLESS:-}" ]] && ROOTLESS=1

# Copy-on-write backend: btrfs subvolumes & snapshots when $shocker_root is btrfs, else overlayfs
# (eg: btrfs kernel module unavailable).  --fs=btrfs or --fs=overlay forces one.
if [[ -z "${SHOCKER_FS:-}" ]]; then
  [[ "$(stat -f -c %T "$shocker_root" 2>/dev/null)" == btrfs ]] && SHOCKER_FS=btrfs || SHOCKER_FS=overlay
fi

# --debug: trace each command, prefixed w/ wall clock (μs) & line number (spot slow/stuck steps)
[[ -n "${SHOCKER_DEBUG:-}" ]] && { PS4='+ ${EPOCHREALTIME:-${SECONDS}} ${LINENO}: '; set -x; }

# util-linux unshare --kill-child: killing a container's unshare kills its whole pid namespace
# (busybox unshare lacks it)
KILL_CHILD=(); unshare --help 2>&1 | grep -q -- --kill-child && KILL_CHILD=(--kill-child)

# Detect cgroup version (0 = unavailable, e.g. nested container without /sys mounted)
CGROUP_VERSION=0
if [[ $ROOTLESS -eq 1 ]]; then
  :  # (no cgroup delegation to us)
elif [[ -f /sys/fs/cgroup/cgroup.controllers ]]; then
  CGROUP_VERSION=2
elif command -v cgcreate &>/dev/null; then
  CGROUP_VERSION=1
fi

# ── helpers ──────────────────────────────────────────────────────────────────

function _uuid() {
  # 5-digit hex suffix → 1,048,576 possible values vs bocker's 252
  printf '%05x' "$((RANDOM * RANDOM % 0xFFFFF))"
}

function btrfs_check() {
  # SHOCKER_DEST bypasses btrfs entirely — pull unpacks straight into a plain directory
  [[ -n "${SHOCKER_DEST:-}" ]] && return
  if [[ $SHOCKER_FS == overlay ]]; then
    mkdir -p "$shocker_root"
    # overlay can't stack on overlayfs (eg: inside a container) & NFS lacks what it needs
    case "$(stat -f -c %T "$shocker_root" 2>/dev/null)" in
      overlayfs|nfs*) echo "$shocker_root is on $(stat -f -c %T "$shocker_root") -- can't hold overlay" \
                        "containers.  Set SHOCKER_ROOT to a dir on eg: ext4, xfs or tmpfs."; exit 1 ;;
    esac
    return
  fi
  # Ensure the btrfs root exists (user must have a btrfs filesystem mounted here)
  if [[ ! -d "$shocker_root" ]]; then
    echo "mount a btrfs filesystem at $shocker_root first - see README.md for suggestion"
    exit 1
  fi
}

function shocker_check() {
  if [[ $SHOCKER_FS == btrfs ]]; then
    btrfs subvolume list "$shocker_root" | grep -qw "$1" && echo 0 || echo 1
  else
    # only our ids: never eg: `..`, which would make `rm ..` delete the store's parent dir
    [[ "$1" =~ ^(img|ps)-[0-9a-f]+$ && -d "$shocker_root/$1" ]] && echo 0 || echo 1
  fi
}

function _subvol_create() { # <dir>
  if [[ $SHOCKER_FS == btrfs ]]; then
    btrfs subvolume create "$1" > /dev/null
  else
    mkdir "$1"
  fi
}

function _snapshot() { # <src> <dst> -- copy-on-write <dst> from <src>
  if [[ $SHOCKER_FS == btrfs ]]; then
    btrfs subvolume snapshot "$1" "$2" > /dev/null
  elif [[ "$(basename "$2")" == ps-* ]]; then
    # container: overlay w/ the image as read-only lower layer; its writes land in upper
    local ovl="$shocker_root/.overlay/$(basename "$2")"
    mkdir -p "$ovl/upper" "$ovl/work" "$2"
    echo "$1" > "$ovl/lower"  # (for _ps_mount)
    _ps_mount "$(basename "$2")"
  else
    # image (eg: commit): plain dir, so it can be a lower layer itself
    mkdir "$2" && cp -a --reflink=auto "$1"/. "$2"
  fi
}

function _ps_mount() { # <container_id> -- ensure an overlay container's root is mounted
  # A container kept after its run (no --rm) loses its overlay mount when the mount namespace it
  # was made in ends: right away when rootless, else at reboot.  Its files all live in upper/.
  local ovl="$shocker_root/.overlay/$1"
  [[ $SHOCKER_FS == overlay && -f "$ovl/lower" ]] || return 0
  mountpoint -q "$shocker_root/$1" && return
  mount -t overlay overlay -o "lowerdir=$(< "$ovl/lower"),upperdir=$ovl/upper,workdir=$ovl/work" \
    "$shocker_root/$1"
}

function _umount_under() { # <dir> -- lazily unmount every mount at or below <dir>, deepest first
  local dir; dir="$(realpath "$1")"
  awk -v d="$dir" '$2 == d || index($2, d "/") == 1 {print $2}' /proc/mounts \
    | sort -r | xargs -r -n1 umount -l 2>/dev/null || true
}

function _subvol_delete() { # <dir>
  # never delete through a mount (eg: a leaked /dev or -v volume would delete the host's files)
  _umount_under "$1"
  if [[ $SHOCKER_FS == btrfs ]]; then
    btrfs subvolume delete "$1" > /dev/null
  else
    rm -rf --one-file-system "$1" "$shocker_root/.overlay/$(basename "$1")"
  fi
}

function _cg_create() { # <id>
  local id=$1
  if [[ $CGROUP_VERSION -eq 2 ]]; then
    mkdir -p /sys/fs/cgroup/"$id"
    echo "+cpu +memory" >> /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || true
  elif [[ $CGROUP_VERSION -eq 1 ]]; then
    cgcreate -g "$cgroups_v1:/$id"
  fi
}

function _cg_set() { # <id>
  local id=$1
  : "${SHOCKER_CPU_SHARE:=1024}"
  : "${SHOCKER_MEM_LIMIT:=512}" # MiB
  if [[ $CGROUP_VERSION -eq 2 ]]; then
    # cgroupsv2: cpu.weight 1-10000 (roughly maps from v1 shares 2-262144)
    local weight=$(( SHOCKER_CPU_SHARE * 10000 / 262144 ))
    [[ $weight -lt 1 ]] && weight=1
    echo "$weight"                          > /sys/fs/cgroup/"$id"/cpu.weight
    echo "$((SHOCKER_MEM_LIMIT * 1048576))" > /sys/fs/cgroup/"$id"/memory.max
  elif [[ $CGROUP_VERSION -eq 1 ]]; then
    cgset -r cpu.shares="$SHOCKER_CPU_SHARE"                          "$id"
    cgset -r memory.limit_in_bytes="$((SHOCKER_MEM_LIMIT * 1048576))" "$id"
  fi
}

function _cg_exec() { # <id> <cmd…>
  local id=$1; shift
  if [[ $CGROUP_VERSION -eq 2 ]]; then
    # Write shell PID into cgroup, then exec (cgexec not available for v2)
    # $1=cgroup.procs path, ${@:2}=actual command — exec preserves all quoting
    local cgroot=/sys/fs/cgroup/"$id"
    bash -c 'echo $$ > "$1" && exec "${@:2}"' -- "${cgroot}/cgroup.procs" "$@"
  elif [[ $CGROUP_VERSION -eq 1 ]]; then
    cgexec -g "$cgroups_v1:$id" "$@"
  else
    "$@"  # (not exec: we're a function -- exec would replace shocker & skip its cleanup)
  fi
}

function _cg_delete() { # <id>
  local id=$1
  if [[ $CGROUP_VERSION -eq 2 ]]; then
    rmdir /sys/fs/cgroup/"$id" 2>/dev/null || true
  elif [[ $CGROUP_VERSION -eq 1 ]]; then
    cgdelete -g "$cgroups_v1:/$id" 2>/dev/null || true
  fi
}

# ── commands ─────────────────────────────────────────────────────────────────

function shocker_init() { #HELP Create an image from a directory:\nSHOCKER init <directory>
  local uuid="img-$(_uuid)"
  if [[ -d "$1" ]]; then
    [[ "$(shocker_check "$uuid")" == 0 ]] && shocker_run "$@"
    _subvol_create "$shocker_root/$uuid"
    cp -rf --reflink=auto "$1"/* "$shocker_root/$uuid" > /dev/null
    mkdir -p "$shocker_root/$uuid/shocker"
    [[ ! -f "$shocker_root/$uuid/shocker/source" ]] && echo "$1" > "$shocker_root/$uuid/shocker/source"
    echo "Created: $uuid"
  else
    echo "No directory named '$1' exists" && exit 1
  fi
}

function shocker_pull() { #HELP Pull an image from Docker Hub (v2 API):\nSHOCKER pull <name[:tag]>
  # SHOCKER_REGISTRY=host:port  — pull-through mirror or private registry.
  # SHOCKER_REGISTRY_USER / SHOCKER_REGISTRY_PASS — credentials when the registry
  #   issues a Bearer auth challenge (e.g. registry.example.com via git.example.com JWT).
  # HTTP is assumed for non-443 ports; Docker Hub is used when SHOCKER_REGISTRY is unset.
  local name tag
  if [[ "$1" == *:* ]]; then
    name="${1%%:*}" tag="${1##*:}"
  else
    name="$1" tag="${2:-latest}"
  fi
  local display="${name}:${tag}"
  # Resolve official images (e.g. "alpine") to library/alpine
  [[ "$name" != */* ]] && name="library/$name"

  local registry token=''
  local -a auth_hdr=()   # populated only when using Docker Hub token auth

  if [[ -n "${SHOCKER_REGISTRY:-}" ]]; then
    # Mirror or private registry: HTTP for non-443 ports, HTTPS otherwise
    local scheme='https'
    local port="${SHOCKER_REGISTRY##*:}"
    [[ "$SHOCKER_REGISTRY" == *:* && "$port" != "443" ]] && scheme='http'
    registry="${scheme}://${SHOCKER_REGISTRY}/v2"
    # Probe for auth challenge (registry.example.com, self-hosted gitlabs might use Bearer JWT auth)
    local www_auth
    www_auth="$(curl -sI "$registry/$name/manifests/$tag" 2>/dev/null \
      | grep -i '^www-authenticate:' | head -1 || true)"
    if [[ -n "$www_auth" ]]; then
      local realm svc scope
      realm="$(echo "$www_auth" | grep -o 'realm="[^"]*"' | cut -d'"' -f2)"
      svc="$(echo  "$www_auth" | grep -o 'service="[^"]*"' | cut -d'"' -f2)"
      scope="repository:${name}:pull"
      local -a cred_args=()
      [[ -n "${SHOCKER_REGISTRY_USER:-}" ]] \
        && cred_args=(-u "${SHOCKER_REGISTRY_USER}:${SHOCKER_REGISTRY_PASS:-}")
      token="$(curl -fsSL "${cred_args[@]}" \
        "${realm}?service=${svc}&scope=${scope}" \
        | jq -r '.token // .access_token // empty' 2>/dev/null || true)"
      [[ -n "$token" ]] && auth_hdr=(-H "Authorization: Bearer $token")
    fi
  else
    # Docker Hub: obtain a bearer token first
    registry='https://registry-1.docker.io/v2'
    token="$(curl -fsSL \
      "https://auth.docker.io/token?service=registry.docker.io&scope=repository:${name}:pull" \
      | grep -o '"token":"[^"]*"' | cut -d'"' -f4)"
    [[ -z "$token" ]] && echo "Failed to authenticate for '$name'" && exit 1
    auth_hdr=(-H "Authorization: Bearer $token")
  fi

  local arch; arch="$(uname -m)"
  # Normalise arch to OCI/Docker naming
  case "$arch" in
    x86_64)  arch='amd64' ;;
    aarch64) arch='arm64' ;;
    armv7l)  arch='arm'   ;;
    i?86)    arch='386'   ;; # eg: iSH on iOS
  esac

  local -a accept=(
    -H 'Accept: application/vnd.docker.distribution.manifest.list.v2+json'
    -H 'Accept: application/vnd.oci.image.index.v1+json'
    -H 'Accept: application/vnd.docker.distribution.manifest.v2+json'
    -H 'Accept: application/vnd.oci.image.manifest.v1+json'
  )
  # The tag's current digest, via HEAD: cheap (& doesn't count against Docker Hub pull limits).
  # Same as the image we already have?  Then just mark it fresh (`source`'s mtime = last pull).
  local digest_now='' have=''
  digest_now="$(curl -fsSI ${auth_hdr[@]+"${auth_hdr[@]}"} "${accept[@]}" \
    "$registry/$name/manifests/$tag" 2>/dev/null | tr -d '\r' \
    | awk 'tolower($1) == "docker-content-digest:" { d = $2 } END { print d }')" || true
  if [[ -n "$digest_now" && -z "${SHOCKER_DEST:-}" ]]; then
    # (/dev/null: w/ nullglob & no images, grep would read stdin)
    have="$(grep -lx "$display" /dev/null "$shocker_root"/img-*/shocker/source 2>/dev/null \
      | tail -1)" || true
    if [[ -n "$have" && "$(cat "${have%/source}/digest" 2>/dev/null)" == "$digest_now" ]]; then
      touch "$have"
      have="${have%/shocker/source}"
      echo "Up to date: ${have##*/}"
      return 0
    fi
  fi

  # Fetch manifest — may be a manifest list (multi-arch index) or a single manifest
  local manifest
  manifest="$(curl -fsSL ${auth_hdr[@]+"${auth_hdr[@]}"} "${accept[@]}" \
    "$registry/$name/manifests/$tag")"
  # Detect manifest list / OCI image index by the presence of a top-level "manifests" array
  # (don't grep mediaType — the inner per-manifest entries appear first and fool head -1)
  local is_index
  is_index="$(echo "$manifest" | jq -r 'has("manifests")' 2>/dev/null)"

  # If we got a manifest list / image index, resolve to the right platform manifest
  if [[ "$is_index" == "true" ]]; then
    # Find the digest for our platform (match arch, prefer linux os)
    local target_digest
    target_digest="$(echo "$manifest" | jq -r --arg arch "$arch" '[.manifests[]
      | select(.platform.architecture == $arch and (.platform.os // "linux") == "linux")][0].digest
      // empty' 2>/dev/null)"
    [[ -z "$target_digest" ]] && echo "No image for arch '$arch' in '$name:$tag'" && exit 1
    manifest="$(curl -fsSL \
      ${auth_hdr[@]+"${auth_hdr[@]}"} \
      -H 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
      -H 'Accept: application/vnd.oci.image.manifest.v1+json' \
      "$registry/$name/manifests/$target_digest")"
  fi

  # Extract only layer digests (exclude the config blob which is not a tarball)
  local layers
  layers="$(echo "$manifest" | jq -r '.layers[]?.digest' 2>/dev/null)"
  [[ -z "$layers" ]] && echo "No image '$name:$tag' found or unsupported manifest" && exit 1

  # Create btrfs subvolume up front; pipe each layer blob directly into tar — zero /tmp usage.
  # SHOCKER_DEST bypasses btrfs and unpacks straight into a plain directory instead.
  local uuid dest
  if [[ -n "${SHOCKER_DEST:-}" ]]; then
    dest="$SHOCKER_DEST"
    # Re-pulling the same dest should reflect the image as-is, not accumulate stale
    # files from a previous pull whose layers no longer include them.
    [[ -e "$dest" ]] && read -rp "[RETURN] to replace existing '$dest' (Ctrl-C to abort)... "
    [[ -e "$dest" ]] && _umount_under "$dest"
    rm -rf --one-file-system "$dest"
    mkdir -p "$dest"
  else
    uuid="img-$(_uuid)"
    dest="$shocker_root/$uuid"
    _subvol_create "$dest"
  fi
  mkdir -p "$dest/shocker"

  # rootless: only uid 0 is mapped, so files can't be chown'd to other users -- flatten to root
  # (-o: don't restore owners; GNU tar & busybox both).  Nor can it mknod: skip whatever's under
  # /dev (some old base images ship device nodes there) -- runs mount the host's /dev over it.
  local -a tar_opts=()
  if [[ $ROOTLESS -eq 1 ]]; then
    tar_opts=(-o)
    # GNU tar's excludes match after any '/' unless --anchored (busybox's are always anchored)
    [[ "$(tar --version 2>/dev/null)" == *GNU* ]] && tar_opts+=(--anchored)
    tar_opts+=(--exclude='dev/?*' --exclude='./dev/?*')
  fi

  while IFS= read -r digest; do
    echo "Pulling layer ${digest:7:19}…"
    if [[ -z "${SHOCKER_REGISTRY:-}" ]]; then
      local cdn_url
      cdn_url="$(curl -sw '%{redirect_url}' -o /dev/null \
        ${auth_hdr[@]+"${auth_hdr[@]}"} \
        "$registry/$name/blobs/$digest")"
      if [[ -n "$cdn_url" ]]; then
        curl -fsSL "$cdn_url" \
          || { echo "Layer download failed. Set SHOCKER_REGISTRY to a pull-through mirror." && exit 1; }
      else
        curl -fsSL ${auth_hdr[@]+"${auth_hdr[@]}"} "$registry/$name/blobs/$digest"
      fi
    else
      curl -fsSL ${auth_hdr[@]+"${auth_hdr[@]}"} "$registry/$name/blobs/$digest"
    fi | tar xzf - ${tar_opts[@]+"${tar_opts[@]}"} -C "$dest"
  done <<< "$layers"

  # Persist ENTRYPOINT+CMD+WORKDIR from the image config blob
  local config_digest
  config_digest="$(echo "$manifest" | jq -r '.config.digest // empty' 2>/dev/null || true)"
  if [[ -n "$config_digest" ]]; then
    local config
    config="$(curl -fsSL ${auth_hdr[@]+"${auth_hdr[@]}"} "$registry/$name/blobs/$config_digest" 2>/dev/null)" || true
    {
      jq -c '(.config.Entrypoint // []) + (.config.Cmd // [])' <<< "$config" > "$dest/shocker/entrypoint"
      jq -j '.config.WorkingDir // ""'                         <<< "$config" > "$dest/shocker/workdir"
      jq -r '(.config.Env // [])[]'                            <<< "$config" > "$dest/shocker/env"
    } 2>/dev/null || true
  fi

  if [[ -z "${SHOCKER_DEST:-}" ]]; then
    local -a _src_files=("$shocker_root"/img-*/shocker/source)
    [[ ${#_src_files[@]} -gt 0 ]] && \
      grep -lx "$display" "${_src_files[@]}" 2>/dev/null \
        | grep -v "/$uuid/shocker/source" \
        | xargs -r -I{} sh -c 'echo _none_ > "{}"' || true # no prior pull of this image is fine
  fi
  # (the tag's digest when pulled: a later pull w/ the same digest skips the download)
  [[ -n "$digest_now" ]] && echo "$digest_now" > "$dest/shocker/digest"
  echo "$display" > "$dest/shocker/source"
  echo "Created: ${uuid:-$dest}"
}

function shocker_rm() { #HELP Delete an image or container:\nSHOCKER rm <image_id or container_id>
  [[ "$(shocker_check "$1")" == 1 ]] && echo "No container named '$1' exists" && exit 1
  _subvol_delete "$shocker_root/$1"
  _cg_delete "$1"
  rm -f "$shocker_root/.rm/$1"
  echo "Removed: $1"
}

function shocker_prune() { #HELP Delete orphaned containers, half-done pulls & images replaced by newer pulls (_none_), unless in use:\nSHOCKER prune [min_age_secs (default 10800: 3h)]
  local min_age="${1:-10800}" lock src img id now
  [[ "$min_age" =~ ^[0-9]+$ ]] || { echo "min_age: want seconds"; exit 1; }
  now=$(date +%s)

  # Orphaned containers: an --rm run that died before its cleanup (eg: SIGKILL, reboot), so nothing
  # holds its lock anymore.  (Kept containers, ie: no --rm, have no lock & are left alone.)
  for lock in "$shocker_root"/.rm/ps-*; do
    [[ -f "$lock" ]] || continue
    id="${lock##*/}"
    (( now - $(stat -c %Y "$lock") >= min_age )) || continue  # (just made: not locked yet?)
    flock -n "$lock" true || continue
    if [[ $ROOTLESS -eq 0 ]]; then  # (rootful network leftovers, if any)
      ip link del dev "veth0_$id" 2>/dev/null || true
      ip netns del "netns_$id" 2>/dev/null || true
    fi
    if [[ -d "$shocker_root/$id" ]]; then shocker_rm "$id"; else rm -f "$lock"; fi
  done

  # Replaced images.  In use = an overlay container (running or kept) is built on it, or a running
  # process names it, eg: `shocker run … img-…` or `-v …/img-…:/opt/x:ro` -- however long ago it
  # started.  (btrfs containers are independent snapshots: deleting their image doesn't affect them.)
  # (snapshot both once: a busy host has many processes & we may check many images.  A run that
  # starts after this can't pick up an old image: names resolve to the current one.)
  # (nullglob: no containers => no files, & a bare `cat` would read stdin -- hence /dev/null)
  local lowers procs
  lowers="$(cat /dev/null "$shocker_root"/.overlay/*/lower 2>/dev/null)" || true
  procs="$(ps -ww -eo args= 2>/dev/null)" || true
  for src in "$shocker_root"/img-*/shocker/source; do
    [[ -f "$src" && "$(< "$src")" == _none_ ]] || continue
    img="${src%/shocker/source}" id="${img##*/}"
    # replaced only recently (`source` was rewritten then): a run may have just picked it up
    (( now - $(stat -c %Y "$src") >= min_age )) || continue
    grep -qE "/$id/?\$" <<< "$lowers" && continue
    grep -qE "$id([^0-9a-f]|\$)" <<< "$procs" && continue
    shocker_rm "$id"
  done

  # Half-done pulls: an img-* w/o `source` (written last) -- the pull died midway.  Only when no
  # pull is running at all (a big layer can take a long time), & only old ones.
  grep -qE '(^|[ /])shocker pull ' <<< "$procs" && return 0
  for img in "$shocker_root"/img-*; do
    [[ -d "$img" && ! -e "$img/shocker/source" ]] || continue
    (( now - $(stat -c %Y "$img") >= min_age )) || continue
    shocker_rm "${img##*/}"
  done
}

function shocker_images() { #HELP List images:\nSHOCKER images
  echo -e "IMAGE_ID\t\tSOURCE"
  for img in "$shocker_root"/img-*; do
    img=$(basename "$img")
    echo -e "$img\t\t$(cat "$shocker_root/$img/shocker/source" 2>/dev/null || echo '(pulling, or a pull died)')"
  done
}

function shocker_ps() { #HELP List containers:\nSHOCKER ps
  echo -e "CONTAINER_ID\t\tCOMMAND"
  for ps in "$shocker_root"/ps-*; do
    ps=$(basename "$ps")
    _ps_mount "$ps"
    echo -e "$ps\t\t$(cat "$shocker_root/$ps/$ps.cmd")"
  done
}

function shocker_run() { #HELP Create a container:\nSHOCKER run [-it] [--rm] [--net=bridge|host|none] [-v src[:dst][:ro]] [-e VAR=val] <image_id | directory> [command]
  # Parse flags
  local interactive=0 do_rm=0 net=bridge net_given=0
  local -a volumes=() env_vars=()
  while [[ "${1:-}" == -* ]]; do
    case "$1" in
      -i|-t|-it|-ti) interactive=1 ;;
      --rm) do_rm=1 ;;
      --net=*) net="${1#--net=}" net_given=1 ;;
      -v) volumes+=("$2"); shift ;;
      -e) env_vars+=("$2"); shift ;;
      *) echo "Unknown flag: $1" && exit 1 ;;
    esac
    shift
  done
  [[ $net =~ ^(bridge|host|none)$ ]] || { echo "Unknown --net=$net (use bridge, host or none)"; exit 1; }
  if [[ $ROOTLESS -eq 1 && $net == bridge ]]; then
    # (the bridge needs real root: veth pairs, iptables NAT.  --net=host matches plain-dir mode.)
    [[ $net_given -eq 1 ]] && { echo "rootless: --net=bridge is unsupported (use host or none)"; exit 1; }
    net=host
  fi

  local img="$1" meta plain=0
  # (img-*/ps-* are always shocker ids, even if cwd is $shocker_root where they're also dirs)
  if [[ -d "$img" && "$img" != img-* && "$img" != ps-* ]]; then
    plain=1
    # Plain dir (eg: from `shocker --dest=mydir pull ..`): no btrfs/netns/cgroups needed
    meta="$img/shocker"
  else
    btrfs_check
    # Allow "alpine" or "alpine:latest" — look up img-XXXXX by img.source content
    if [[ "$img" != img-* && "$img" != ps-* ]]; then
      local search="$img"; [[ "$img" != *:* ]] && search="$img:latest"
      # (/dev/null: w/ nullglob & no images, grep -r would search the current dir)
      img=$(grep -lx "$search" /dev/null "$shocker_root"/img-*/shocker/source 2>/dev/null \
            | head -1 | sed 's|.*/\(img-[^/]*\)/.*|\1|') || true
      [[ -z "$img" ]] && echo "No image named '$1' exists" && exit 1
    fi
    [[ "$(shocker_check "$img")" == 1 ]] && echo "No image named '$img' exists" && exit 1
    meta="$shocker_root/$img/shocker"
  fi

  local -a cmd_args=("${@:2}") # this is command plus all args
  [[ ${#cmd_args[@]} -eq 0 && $interactive -eq 1 ]] && cmd_args=('/bin/sh')
  if [[ ${#cmd_args[@]} -eq 0 ]]; then
    local ep_file="$meta/entrypoint"
    [[ -f "$ep_file" ]] && mapfile -t cmd_args < <(jq -r '.[]' "$ep_file") 2>/dev/null || true
    [[ ${#cmd_args[@]} -eq 0 ]] && echo "No command specified (and image has no ENTRYPOINT/CMD)" && exit 1
  fi
  local workdir='/'
  local wd_file="$meta/workdir"
  [[ -f "$wd_file" ]] && workdir="$(cat "$wd_file")"
  [[ -z "$workdir" ]] && workdir='/'
  local -a img_env=()
  local env_file="$meta/env"
  [[ -f "$env_file" ]] && mapfile -t img_env < "$env_file"
  cmd_args=("env" "-i" "${img_env[@]}" "${env_vars[@]}" "${cmd_args[@]}")

  # NOTE: test the flag, not `-d "$img"` -- by now a named image has resolved to eg: img-XXXXX,
  # which is also a (relative) dir when cwd is $shocker_root.
  if [[ $plain -eq 1 ]]; then
    # Runs in place (changes persist; --rm ignored) w/ host networking.  Uses unshare if it works.
    mkdir -p "$img/etc" && cp /etc/resolv.conf "$img/etc/resolv.conf"
    # private: our /dev, /proc & -v mounts must never propagate back to the host
    local -a ns=(unshare -fmuip --propagation private)
    # subshell keeps bash's "Bad system call" notice quiet (iSH has no unshare syscall)
    ( "${ns[@]}" true && exit 0; exit 1 ) 2>/dev/null || ns=()
    local rc=0
    nsroot="$img" nvols="${#volumes[@]}" workdir="$workdir" \
      ${ns[@]+"${ns[@]}"} /bin/sh -c "$_ns_script" -- ${volumes[@]+"${volumes[@]}"} "${cmd_args[@]}" || rc=$?
    # no mount namespace => our /dev, /proc & -v mounts landed on the host; undo them all
    [[ ${#ns[@]} -eq 0 ]] && _umount_under "$img"
    return $rc
  fi

  if [[ $net == bridge ]]; then
    # One-time bridge + NAT setup (survives until reboot; harmless if already exists)
    if ! ip link show bridge0 &>/dev/null; then
      ip link add name bridge0 type bridge
      ip addr add 10.0.0.1/24 dev bridge0
      ip link set bridge0 up
      echo 1 > /proc/sys/net/ipv4/ip_forward
      iptables -t nat -A POSTROUTING -s 10.0.0.0/24 ! -o bridge0 -j MASQUERADE
    fi
    # Ensure FORWARD rules exist (survive reboots; idempotent via -C check)
    iptables -C FORWARD -i bridge0 -j ACCEPT &>/dev/null \
      || iptables -I FORWARD -i bridge0 -j ACCEPT
    iptables -C FORWARD -o bridge0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT &>/dev/null \
      || iptables -I FORWARD -o bridge0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  fi

  # UUID conflict: loop rather than recurse (recursion would lose parsed flags)
  local uuid
  while true; do
    uuid="ps-$(_uuid)"
    [[ "$(shocker_check "$uuid")" == 1 ]] && break
    echo "UUID conflict, retrying…"
  done

  # --net=host: share the host's network namespace.  none: own netns w/ just loopback.
  # (rootless can't use named netns in /run/netns -- _run_ns unshares one directly instead)
  local named_netns=0
  [[ $net != host && $ROOTLESS -eq 0 ]] && named_netns=1
  if [[ $named_netns -eq 1 ]]; then
    ip netns add netns_"$uuid"
    nsenter --net=/run/netns/netns_"$uuid" ip link set dev lo up
  fi
  if [[ $net == bridge ]]; then
    # Derive IP from full 5-hex-digit UUID value (1–253) to minimize collision
    local hex="${uuid#ps-}"
    local suffix; suffix=$(( 16#${hex} % 253 + 1 ))
    local ip="10.0.0.$suffix"
    # Proper 6-octet MAC: fixed OUI 02:42 + 4 hex digits zero-padded from UUID
    local u8; u8="$(printf '%08x' "$((16#${hex}))")"
    local mac="02:42:${u8:0:2}:${u8:2:2}:${u8:4:2}:${u8:6:2}"

    ip link add dev veth0_"$uuid" type veth peer name veth1_"$uuid"
    ip link set dev veth0_"$uuid" up
    ip link set veth0_"$uuid" master bridge0
    ip link set veth1_"$uuid" netns netns_"$uuid"
    nsenter --net=/run/netns/netns_"$uuid" ip link set veth1_"$uuid" address "$mac"
    nsenter --net=/run/netns/netns_"$uuid" ip addr add "$ip/24" dev veth1_"$uuid"
    nsenter --net=/run/netns/netns_"$uuid" ip link set dev veth1_"$uuid" up
    nsenter --net=/run/netns/netns_"$uuid" ip route add default via 10.0.0.1
  fi

  # --rm: lock .rm/<id> for the whole run.  Its processes inherit the lock, so the kernel frees it
  # only when they've all exited, however they died -- so `prune` can tell a container whose run
  # died before its cleanup (eg: SIGKILL, reboot) from one still running.
  local lockfd=''
  if [[ $do_rm -eq 1 ]]; then
    mkdir -p "$shocker_root/.rm"
    exec {lockfd}> "$shocker_root/.rm/$uuid"
    flock "$lockfd"
  fi

  local root="$shocker_root/$uuid"

  _snapshot "$shocker_root/$img" "$root"
  mkdir -p "$root/etc"

  # use host DNS resolving
  cp /etc/resolv.conf "$root/etc/resolv.conf"

  echo "${cmd_args[*]}" > "$root/$uuid.cmd"

  _cg_create "$uuid"
  _cg_set    "$uuid"

  # capture the command's exit status (vs. errexit) so cleanup below always happens
  local -a all_vols=("${volumes[@]}")
  local rc=0
  if [[ $interactive -eq 1 ]]; then
    _run_ns "$uuid" "$root" "${#all_vols[@]}" "$workdir" "${all_vols[@]}" "${cmd_args[@]}" || rc=$?
  else
    # (pipefail: rc is the command's status, not tee's)
    # not -i: stdin is /dev/null, like docker -- never our terminal
    _run_ns "$uuid" "$root" "${#all_vols[@]}" "$workdir" "${all_vols[@]}" "${cmd_args[@]}" \
      < /dev/null 2>&1 | tee "$root/$uuid.log" || rc=$?
  fi

  [[ $net == bridge ]] && ip link del dev veth0_"$uuid"
  [[ $named_netns -eq 1 ]] && ip netns del netns_"$uuid"

  # --snitch: report what the container wrote outside its -v volumes (overlay upper layer).
  # (c = whiteout, ie: deleted from the image.  $uuid.cmd, $uuid.log & etc/resolv.conf are shocker's.)
  if [[ -n "${SHOCKER_SNITCH:-}" && $SHOCKER_FS == overlay ]]; then
    local upper="$shocker_root/.overlay/$uuid/upper"
    echo "snitch: $uuid wrote $(du -sh "$upper" | cut -f1) outside its volumes (biggest first):" >&2
    (cd "$upper" && find . -mindepth 1 ! -type d -printf '%s\t%y %p\n' | sort -rn | head -50) >&2
  fi

  [[ $do_rm -eq 1 ]] && shocker_rm "$uuid" > /dev/null
  [[ -n "$lockfd" ]] && exec {lockfd}>&-
  return $rc
}
# Runs inside the new mount namespace (if any).  env: nsroot nvols workdir.  args: [vol…] <cmd…>
_ns_script='
  # <root> <path>: echo <path> w/ symlinks resolved as if <root> were /  (".." stops at <root>)
  _in_root() {
    _root=$1 _rest=$2 _out= _n=0
    while :; do
      _rest=${_rest#"${_rest%%[!/]*}"}  # strip leading slashes
      [ -z "$_rest" ] && break
      _c=${_rest%%/*}
      case $_rest in */*) _rest=${_rest#*/} ;; *) _rest= ;; esac
      case $_c in
        .) ;;
        ..) _out=${_out%/*} ;;
        *)
          if [ -L "$_root$_out/$_c" ]; then
            _n=$((_n+1)); [ $_n -gt 40 ] && return 1
            _t=$(readlink "$_root$_out/$_c")
            case $_t in /*) _out= ;; esac  # absolute target: restart from <root>
            _rest="$_t/$_rest"
          else
            _out="$_out/$_c"
          fi ;;
      esac
    done
    echo "${_out:-/}"
  }
  # <src> <bind mountpoint>: make the bind read-only.  (busybox mount wants src & dst both.)
  _ro_remount() {
    mount -o remount,bind,ro "$1" "$2" 2>/dev/null && return
    # in a user namespace, flags inherited from the outer mount (nodev, nosuid, noexec) are
    # locked, so a remount must repeat them
    _f=$(awk -v t="$2" "\$2 == t { o = \$4 } END { print o }" /proc/self/mounts \
      | tr , "\n" | grep -xE "nodev|nosuid|noexec" | paste -sd, -)
    mount -o "remount,bind,ro${_f:+,$_f}" "$1" "$2"
  }
  # (rootless --net=none: our fresh netns has loopback down)
  [ -n "${nslo:-}" ] && ip link set dev lo up
  # (rootless cannot mount devtmpfs.  --rbind: in a user namespace a plain --bind of /dev fails,
  # since its submounts, eg: /dev/pts, are locked & a non-recursive bind would hide them.)
  mount -t devtmpfs devtmpfs "$nsroot/dev" 2>/dev/null || mount --rbind /dev "$nsroot/dev" 2>/dev/null \
    || echo "warning: no /dev in container (eg: no /dev/null)" >&2
  mount -n -t proc proc "$nsroot/proc" 2>/dev/null
  i=0; while [ "$i" -lt "$nvols" ]; do
    volarg=$1; shift; i=$((i+1))
    ro=0; case "$volarg" in *:ro) ro=1; volarg="${volarg%:ro}" ;; esac
    src="${volarg%%:*}" dst="${volarg#*:}"
    # resolve dst *inside* the container root (like docker), so an image symlink, eg: /t -> /var/..,
    # is followed within the image -- not out onto the host
    dst=$(_in_root "$nsroot" "$dst") || { echo "error: -v $volarg: symlink loop" >&2; exit 1; }
    # (else we would make an empty file at dst & the bind would fail -- a confusing half-container)
    [ -e "$src" ] || { echo "error: -v $volarg: no such file or directory: $src" >&2; exit 1; }
    if [ -d "$src" ]; then mkdir -p "$nsroot$dst"
    else mkdir -p "$(dirname "$nsroot$dst")" && touch "$nsroot$dst"; fi
    if ! mount --bind "$src" "$nsroot$dst" 2>/dev/null; then
      echo "warning: could not mount -v $volarg" >&2
    elif [ "$ro" = 1 ] && ! _ro_remount "$src" "$nsroot$dst"; then
      # never silently fall back to read-write
      echo "error: could not make -v $volarg read-only" >&2; exit 1
    fi
  done
  exec chroot "$nsroot" /bin/sh -c "cd \"$workdir\" && exec \"\$@\"" -- "$@"
'
function _run_ns() { # <uuid> <root> <nvols> <workdir> [vol…] <cmd…>   (uses caller's $net)
  local uuid=$1 nsroot=$2 nvols=$3 workdir=$4; shift 4
  local -a netns=(nsenter --net=/run/netns/netns_"$uuid")
  local ns_flags=-fmuip nslo=''
  [[ $net == host ]] && netns=()
  if [[ $ROOTLESS -eq 1 ]]; then
    netns=()
    [[ $net == none ]] && ns_flags=-fmuipn nslo=x
  fi
  # --kill-child: if unshare gets killed (eg: SIGTERM from a supervisor), the container's
  # pid 1 is killed too -- and w/ it, everything in the container's pid namespace
  nsroot="$nsroot" nvols="$nvols" workdir="$workdir" nslo="$nslo" \
  _cg_exec "$uuid" \
    ${netns[@]+"${netns[@]}"} \
      unshare $ns_flags --propagation private ${KILL_CHILD[@]+"${KILL_CHILD[@]}"} \
        /bin/sh -c "$_ns_script" -- "$@"
}

function shocker_exec() { #HELP Execute a command in a running container:\nSHOCKER exec <container_id> <command>
  [[ "$(shocker_check "$1")" == 1 ]] && echo "No container named '$1' exists" && exit 1
  # Find the unshare process that owns this container's namespace
  local cid
  cid="$(ps -eo pid,args \
    | awk -v u="$1" '$0 ~ "unshare.*"u {print $1}' \
    | head -1)"
  [[ -z "$cid" ]] && echo "Container '$1' exists but is not running" && exit 1
  nsenter -t "$cid" -m -u -i -n -p chroot "$shocker_root/$1" "${@:2}"
}

function shocker_logs() { #HELP View logs from a container:\nSHOCKER logs <container_id>
  [[ "$(shocker_check "$1")" == 1 ]] && echo "No container named '$1' exists" && exit 1
  _ps_mount "$1"
  cat "$shocker_root/$1/$1.log"
}

function shocker_commit() { #HELP Commit a container to an image:\nSHOCKER commit <container_id> <image_id>
  [[ "$(shocker_check "$1")" == 1 ]] && echo "No container named '$1' exists" && exit 1
  [[ "$(shocker_check "$2")" == 1 ]] && echo "No image named '$2' exists" && exit 1
  _ps_mount "$1"
  # copy first: under overlay, the container may be layered on the very image we're replacing
  local tmp="$shocker_root/.commit-$2"
  _snapshot "$shocker_root/$1" "$tmp"
  shocker_rm "$2" && mv "$tmp" "$shocker_root/$2"
  # (no longer the registry's image: a later pull mustn't think it's up to date)
  rm -f "$shocker_root/$2/shocker/digest"
  echo "Created: $2"
}

function shocker_help() { #HELP Display this message:\nSHOCKER help
  grep '^function.*#HELP' "$1" | sed "s/^.*#HELP //;s/\\\\n/\n\t/g;s/$/\n/;s!SHOCKER!${1/!/\\!}!g"
}

# ── dispatch ─────────────────────────────────────────────────────────────────

[[ -z "${1-}" ]] && shocker_help "$0" && exit 0

case $1 in
  pull|init|rm|prune|images|ps|exec|logs|commit) btrfs_check; shocker_"$1" "${@:2}" ;;
  run) shocker_run "${@:2}" ;; # does its own btrfs_check (unless running a plain dir)
  *) shocker_help "$0" ;;
esac
