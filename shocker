#!/usr/bin/env bash
# shocker — Docker implemented in around 300 lines of bash ⚡️
# Fork of bocker (github.com/p8952/bocker).  Updated for 2026.
#   - Docker Registry v2 API (v1 was shut down in 2023)
#   - cgroups v2 support with v1 fallback
#   - Improved UUID space & MAC address generation
#   - More robust container PID lookup

set -o errexit -o nounset -o pipefail; shopt -s nullglob

btrfs_path='/var/shocker'
# cgroups v1 legacy controllers (used only if cgroupsv2 is absent)
cgroups_v1='cpu,cpuacct,memory'

[[ $# -gt 0 ]] && while [ "${1:0:2}" == '--' ]; do
  OPTION=${1:2}
  [[ $OPTION =~ = ]] && declare "SHOCKER_${OPTION/=*/}=${OPTION/*=/}" \
                     || declare "SHOCKER_${OPTION}=x"
  shift
done

# Detect cgroup version
if [[ -f /sys/fs/cgroup/cgroup.controllers ]]; then
  CGROUP_VERSION=2
else
  CGROUP_VERSION=1
fi

# ── helpers ──────────────────────────────────────────────────────────────────

function _uuid() {
  # 5-digit hex suffix → 1,048,576 possible values vs bocker's 252
  printf '%05x' "$((RANDOM * RANDOM % 0xFFFFF))"
}

function btrfs_check() {
  # Ensure the btrfs root exists (user must have a btrfs filesystem mounted here)
  if [[ ! -d "$btrfs_path" ]]; then
    echo "mount a btrfs filesystem at $btrfs_path first - see REAMDE.md for suggestion"
    exit 1
  fi
}

function shocker_check() {
  btrfs subvolume list "$btrfs_path" | grep -qw "$1" && echo 0 || echo 1
}

function _cg_create() { # <id>
  local id=$1
  if [[ $CGROUP_VERSION -eq 2 ]]; then
    mkdir -p /sys/fs/cgroup/"$id"
    echo "+cpu +memory" >> /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || true
  else
    cgcreate -g "$cgroups_v1:/$id"
  fi
}

function _cg_set() { # <id>
  local id=$1
  : "${SHOCKER_CPU_SHARE:=512}"
  : "${SHOCKER_MEM_LIMIT:=512}" # MiB
  if [[ $CGROUP_VERSION -eq 2 ]]; then
    # cgroupsv2: cpu.weight 1-10000 (roughly maps from v1 shares 2-262144)
    local weight=$(( SHOCKER_CPU_SHARE * 10000 / 262144 ))
    [[ $weight -lt 1 ]] && weight=1
    echo "$weight"                          > /sys/fs/cgroup/"$id"/cpu.weight
    echo "$((SHOCKER_MEM_LIMIT * 1048576))" > /sys/fs/cgroup/"$id"/memory.max
  else
    cgset -r cpu.shares="$SHOCKER_CPU_SHARE"                          "$id"
    cgset -r memory.limit_in_bytes="$((SHOCKER_MEM_LIMIT * 1048576))" "$id"
  fi
}

function _cg_exec() { # <id> <cmd…>
  local id=$1; shift
  if [[ $CGROUP_VERSION -eq 2 ]]; then
    # Write shell PID into cgroup, then exec (cgexec not available for v2)
    # $1=cgroup.procs path, ${@:2}=actual command — exec preserves all quoting
    local cgroot=/sys/fs/cgroup/"$id"
    bash -c 'echo $$ > "$1" && exec "${@:2}"' -- "${cgroot}/cgroup.procs" "$@"
  else
    cgexec -g "$cgroups_v1:$id" "$@"
  fi
}

function _cg_delete() { # <id>
  local id=$1
  if [[ $CGROUP_VERSION -eq 2 ]]; then
    rmdir /sys/fs/cgroup/"$id" 2>/dev/null || true
  else
    cgdelete -g "$cgroups_v1:/$id" 2>/dev/null || true
  fi
}

# ── commands ─────────────────────────────────────────────────────────────────

function shocker_init() { #HELP Create an image from a directory:\nSHOCKER init <directory>
  local uuid="img_$(_uuid)"
  if [[ -d "$1" ]]; then
    [[ "$(shocker_check "$uuid")" == 0 ]] && shocker_run "$@"
    btrfs subvolume create "$btrfs_path/$uuid" > /dev/null
    cp -rf --reflink=auto "$1"/* "$btrfs_path/$uuid" > /dev/null
    [[ ! -f "$btrfs_path/$uuid/img.source" ]] && echo "$1" > "$btrfs_path/$uuid/img.source"
    echo "Created: $uuid"
  else
    echo "No directory named '$1' exists" && exit 1
  fi
}

function shocker_pull() { #HELP Pull an image from Docker Hub (v2 API):\nSHOCKER pull <name[:tag]>
  # Set SHOCKER_REGISTRY=host:port to use a pull-through mirror (e.g. Nexus).
  # The mirror serves blobs directly so no CDN redirect issues; HTTP is assumed for
  # non-standard ports. Docker Hub is used when SHOCKER_REGISTRY is unset.
  local name tag
  if [[ "$1" == *:* ]]; then
    name="${1%%:*}" tag="${1##*:}"
  else
    name="$1" tag="${2:-latest}"
  fi
  local display="${name}:${tag}"
  # Resolve official images (e.g. "alpine") to library/alpine
  [[ "$name" != */* ]] && name="library/$name"

  local registry token=''
  local -a auth_hdr=()   # populated only when using Docker Hub token auth

  if [[ -n "${SHOCKER_REGISTRY:-}" ]]; then
    # Mirror (e.g. Nexus): anonymous pull, blobs served directly, HTTP for non-443 ports
    local scheme='https'
    local port="${SHOCKER_REGISTRY##*:}"
    [[ "$SHOCKER_REGISTRY" == *:* && "$port" != "443" ]] && scheme='http'
    registry="${scheme}://${SHOCKER_REGISTRY}/v2"
  else
    # Docker Hub: obtain a bearer token first
    registry='https://registry-1.docker.io/v2'
    token="$(curl -fsSL \
      "https://auth.docker.io/token?service=registry.docker.io&scope=repository:${name}:pull" \
      | grep -o '"token":"[^"]*"' | cut -d'"' -f4)"
    [[ -z "$token" ]] && echo "Failed to authenticate for '$name'" && exit 1
    auth_hdr=(-H "Authorization: Bearer $token")
  fi

  local arch; arch="$(uname -m)"
  # Normalise arch to OCI/Docker naming
  case "$arch" in
    x86_64)  arch='amd64' ;;
    aarch64) arch='arm64' ;;
    armv7l)  arch='arm'   ;;
  esac

  # Fetch manifest — may be a manifest list (multi-arch index) or a single manifest
  local manifest
  manifest="$(curl -fsSL \
    "${auth_hdr[@]}" \
    -H 'Accept: application/vnd.docker.distribution.manifest.list.v2+json' \
    -H 'Accept: application/vnd.oci.image.index.v1+json' \
    -H 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
    -H 'Accept: application/vnd.oci.image.manifest.v1+json' \
    "$registry/$name/manifests/$tag")"
  # Detect manifest list / OCI image index by the presence of a top-level "manifests" array
  # (don't grep mediaType — the inner per-manifest entries appear first and fool head -1)
  local is_index
  is_index="$(echo "$manifest" | python3 -c \
    "import sys,json; d=json.load(sys.stdin); print('1' if 'manifests' in d else '0')" 2>/dev/null)"

  # If we got a manifest list / image index, resolve to the right platform manifest
  if [[ "$is_index" == "1" ]]; then
    # Find the digest for our platform (match arch, prefer linux os)
    local target_digest
    target_digest="$(echo "$manifest" \
      | python3 -c "
import sys, json
data = json.load(sys.stdin)
arch = '${arch}'
for m in data.get('manifests', []):
    p = m.get('platform', {})
    if p.get('architecture') == arch and p.get('os', 'linux') == 'linux':
        print(m['digest'])
        break
" 2>/dev/null)"
    [[ -z "$target_digest" ]] && echo "No image for arch '$arch' in '$name:$tag'" && exit 1
    manifest="$(curl -fsSL \
      "${auth_hdr[@]}" \
      -H 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
      -H 'Accept: application/vnd.oci.image.manifest.v1+json' \
      "$registry/$name/manifests/$target_digest")"
  fi

  # Extract only layer digests (exclude the config blob which is not a tarball)
  local layers
  layers="$(echo "$manifest" \
    | python3 -c "
import sys, json
data = json.load(sys.stdin)
for l in data.get('layers', []):
    print(l['digest'])
" 2>/dev/null)"
  [[ -z "$layers" ]] && echo "No image '$name:$tag' found or unsupported manifest" && exit 1

  local tmp_dir; tmp_dir="$(mktemp -d)"

  while IFS= read -r digest; do
    echo "Pulling layer ${digest:7:19}…"
    if [[ -z "${SHOCKER_REGISTRY:-}" ]]; then
      # Docker Hub redirects blob downloads to a CDN (CloudFront/S3).
      # Capture the redirect URL without following it, then download directly
      # (--noproxy) — the signed URL has auth in query params, no header needed.
      local cdn_url
      cdn_url="$(curl -sw '%{redirect_url}' -o /dev/null \
        "${auth_hdr[@]}" \
        "$registry/$name/blobs/$digest")"
      if [[ -n "$cdn_url" ]]; then
        curl -fsSL --noproxy '*' "$cdn_url" -o "$tmp_dir/layer.tar" \
          || { echo "Layer download failed — CDN unreachable directly. Set SHOCKER_REGISTRY to a pull-through mirror (e.g. nexus.us.archive.org:8080)." && exit 1; }
      else
        curl -fsSL "${auth_hdr[@]}" "$registry/$name/blobs/$digest" -o "$tmp_dir/layer.tar"
      fi
    else
      # Mirror (Nexus etc.): blobs served directly, no CDN redirect
      curl -fsSL "${auth_hdr[@]}" "$registry/$name/blobs/$digest" -o "$tmp_dir/layer.tar"
    fi
    tar xf "$tmp_dir/layer.tar" -C "$tmp_dir" && rm "$tmp_dir/layer.tar"
  done <<< "$layers"

  echo "$display" > "$tmp_dir/img.source"
  shocker_init "$tmp_dir" && rm -rf "$tmp_dir"
}

function shocker_rm() { #HELP Delete an image or container:\nSHOCKER rm <image_id or container_id>
  [[ "$(shocker_check "$1")" == 1 ]] && echo "No container named '$1' exists" && exit 1
  btrfs subvolume delete "$btrfs_path/$1" > /dev/null
  _cg_delete "$1"
  echo "Removed: $1"
}

function shocker_images() { #HELP List images:\nSHOCKER images
  echo -e "IMAGE_ID\t\tSOURCE"
  for img in "$btrfs_path"/img_*; do
    img=$(basename "$img")
    echo -e "$img\t\t$(cat "$btrfs_path/$img/img.source")"
  done
}

function shocker_ps() { #HELP List containers:\nSHOCKER ps
  echo -e "CONTAINER_ID\t\tCOMMAND"
  for ps in "$btrfs_path"/ps_*; do
    ps=$(basename "$ps")
    echo -e "$ps\t\t$(cat "$btrfs_path/$ps/$ps.cmd")"
  done
}

function shocker_run() { #HELP Create a container:\nSHOCKER run [-it] [--rm] <image_id> [command]
  # Parse flags
  local interactive=0 do_rm=0
  while [[ "${1:-}" == -* ]]; do
    case "$1" in
      -i|-t|-it|-ti) interactive=1 ;;
      --rm) do_rm=1 ;;
      *) echo "Unknown flag: $1" && exit 1 ;;
    esac
    shift
  done

  # One-time bridge + NAT setup (survives until reboot; harmless if already exists)
  if ! ip link show bridge0 &>/dev/null; then
    ip link add name bridge0 type bridge
    ip addr add 10.0.0.1/24 dev bridge0
    ip link set bridge0 up
    echo 1 > /proc/sys/net/ipv4/ip_forward
    iptables -t nat -A POSTROUTING -s 10.0.0.0/24 ! -o bridge0 -j MASQUERADE
  fi
  # Ensure FORWARD rules exist (survive reboots; idempotent via -C check)
  iptables -C FORWARD -i bridge0 -j ACCEPT &>/dev/null \
    || iptables -I FORWARD -i bridge0 -j ACCEPT
  iptables -C FORWARD -o bridge0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT &>/dev/null \
    || iptables -I FORWARD -o bridge0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

  # UUID conflict: loop rather than recurse (recursion would lose parsed flags)
  local uuid
  while true; do
    uuid="ps_$(_uuid)"
    [[ "$(shocker_check "$uuid")" == 1 ]] && break
    echo "UUID conflict, retrying…"
  done

  [[ "$(shocker_check "$1")" == 1 ]] && echo "No image named '$1' exists" && exit 1

  local cmd="${*:2}"
  [[ -z "$cmd" && $interactive -eq 1 ]] && cmd='/bin/sh'
  [[ -z "$cmd" ]] && echo "No command specified" && exit 1
  # Derive IP from full 5-hex-digit UUID value (1–253) to minimize collision
  local hex="${uuid#ps_}"
  local suffix; suffix=$(( 16#${hex} % 253 + 1 ))
  local ip="10.0.0.$suffix"
  # Proper 6-octet MAC: fixed OUI 02:42 + 4 hex digits zero-padded from UUID
  local u8; u8="$(printf '%08x' "$((16#${hex}))")"
  local mac="02:42:${u8:0:2}:${u8:2:2}:${u8:4:2}:${u8:6:2}"

  ip link add dev veth0_"$uuid" type veth peer name veth1_"$uuid"
  ip link set dev veth0_"$uuid" up
  ip link set veth0_"$uuid" master bridge0
  ip netns add netns_"$uuid"
  ip link set veth1_"$uuid" netns netns_"$uuid"
  ip netns exec netns_"$uuid" ip link set dev lo up
  ip netns exec netns_"$uuid" ip link set veth1_"$uuid" address "$mac"
  ip netns exec netns_"$uuid" ip addr add "$ip/24" dev veth1_"$uuid"
  ip netns exec netns_"$uuid" ip link set dev veth1_"$uuid" up
  ip netns exec netns_"$uuid" ip route add default via 10.0.0.1

  local root="$btrfs_path/$uuid"

  btrfs subvolume snapshot "$btrfs_path/$1" "$root" > /dev/null
  mkdir -p "$root/etc"

  # use host DNS resolving
  cp /etc/resolv.conf "$root/etc/resolv.conf"

  echo "$cmd" > "$root/$uuid.cmd"

  _cg_create "$uuid"
  _cg_set    "$uuid"

  if [[ $interactive -eq 1 ]]; then
    mkdir -p "$root/dev/pts"
    touch "$root/dev/tty"
    # Inside the new mount namespace: bind /dev/pts + /dev/tty so the PTY works, then chroot.
    # $1=root $2=cmd avoids quoting issues across the exec boundary.
    _cg_exec "$uuid" \
      ip netns exec netns_"$uuid" \
      unshare -fmuip --mount-proc="$root/proc" \
      /bin/sh -c 'mount --bind /dev/pts "$1/dev/pts" 2>/dev/null && mount --bind /dev/tty "$1/dev/tty" 2>/dev/null && exec chroot "$1" /bin/sh -c "$2"' \
      -- "$root" "$cmd" || true
  else
    _cg_exec "$uuid" \
      ip netns exec netns_"$uuid" \
      unshare -fmuip --mount-proc="$root/proc" \
      chroot "$root" \
      /bin/sh -c "$cmd" \
      2>&1 | tee "$root/$uuid.log" || true
  fi

  ip link del dev veth0_"$uuid"
  ip netns del netns_"$uuid"

  [[ $do_rm -eq 1 ]] && shocker_rm "$uuid" > /dev/null
}

function shocker_exec() { #HELP Execute a command in a running container:\nSHOCKER exec <container_id> <command>
  [[ "$(shocker_check "$1")" == 1 ]] && echo "No container named '$1' exists" && exit 1
  # Find the unshare process that owns this container's namespace
  local cid
  cid="$(ps -eo pid,args \
    | awk -v u="$1" '$0 ~ "unshare.*"u {print $1}' \
    | head -1)"
  [[ -z "$cid" ]] && echo "Container '$1' exists but is not running" && exit 1
  nsenter -t "$cid" -m -u -i -n -p chroot "$btrfs_path/$1" "${@:2}"
}

function shocker_logs() { #HELP View logs from a container:\nSHOCKER logs <container_id>
  [[ "$(shocker_check "$1")" == 1 ]] && echo "No container named '$1' exists" && exit 1
  cat "$btrfs_path/$1/$1.log"
}

function shocker_commit() { #HELP Commit a container to an image:\nSHOCKER commit <container_id> <image_id>
  [[ "$(shocker_check "$1")" == 1 ]] && echo "No container named '$1' exists" && exit 1
  [[ "$(shocker_check "$2")" == 1 ]] && echo "No image named '$2' exists" && exit 1
  shocker_rm "$2" && btrfs subvolume snapshot "$btrfs_path/$1" "$btrfs_path/$2" > /dev/null
  echo "Created: $2"
}

function shocker_help() { #HELP Display this message:\nSHOCKER help
  grep '^function.*#HELP' "$1" | sed "s/^.*#HELP //;s/\\\\n/\n\t/g;s/$/\n/;s!SHOCKER!${1/!/\\!}!g"
}

# ── dispatch ─────────────────────────────────────────────────────────────────

[[ -z "${1-}" ]] && shocker_help "$0" && exit 0

case $1 in
  pull|init|rm|images|ps|run|exec|logs|commit) btrfs_check; shocker_"$1" "${@:2}" ;;
  *) shocker_help "$0" ;;
esac
