#!/usr/bin/env bash
# shocker — Docker implemented in around 300 lines of bash ⚡️
# Fork of bocker (github.com/p8952/bocker).  Updated for 2026.
#   - Docker Registry v2 API (v1 was shut down in 2023)
#   - cgroups v2 support with v1 fallback
#   - Improved UUID space & MAC address generation
#   - More robust container PID lookup

set -o errexit -o nounset -o pipefail; shopt -s nullglob

btrfs_path='/var/shocker'
# cgroups v1 legacy controllers (used only if cgroupsv2 is absent)
cgroups_v1='cpu,cpuacct,memory'

[[ $# -gt 0 ]] && while [ "${1:0:2}" == '--' ]; do
  OPTION=${1:2}
  KEY=$(echo "${OPTION/=*/}" | tr a-z- A-Z_) # eg: --dest=x => SHOCKER_DEST=x
  [[ $OPTION =~ = ]] && declare "SHOCKER_${KEY}=${OPTION#*=}" \
                     || declare "SHOCKER_${KEY}=x"
  shift
done

# --debug: trace each command, prefixed w/ elapsed seconds & line number (spot slow/stuck steps)
[[ -n "${SHOCKER_DEBUG:-}" ]] && { PS4='+ ${SECONDS}s ${LINENO}: '; set -x; }

# Detect cgroup version (0 = unavailable, e.g. nested container without /sys mounted)
CGROUP_VERSION=0
if [[ -f /sys/fs/cgroup/cgroup.controllers ]]; then
  CGROUP_VERSION=2
elif command -v cgcreate &>/dev/null; then
  CGROUP_VERSION=1
fi

# ── helpers ──────────────────────────────────────────────────────────────────

function _uuid() {
  # 5-digit hex suffix → 1,048,576 possible values vs bocker's 252
  printf '%05x' "$((RANDOM * RANDOM % 0xFFFFF))"
}

function btrfs_check() {
  # SHOCKER_DEST bypasses btrfs entirely — pull unpacks straight into a plain directory
  [[ -n "${SHOCKER_DEST:-}" ]] && return
  # Ensure the btrfs root exists (user must have a btrfs filesystem mounted here)
  if [[ ! -d "$btrfs_path" ]]; then
    echo "mount a btrfs filesystem at $btrfs_path first - see REAMDE.md for suggestion"
    exit 1
  fi
}

function shocker_check() {
  btrfs subvolume list "$btrfs_path" | grep -qw "$1" && echo 0 || echo 1
}

function _cg_create() { # <id>
  local id=$1
  if [[ $CGROUP_VERSION -eq 2 ]]; then
    mkdir -p /sys/fs/cgroup/"$id"
    echo "+cpu +memory" >> /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || true
  elif [[ $CGROUP_VERSION -eq 1 ]]; then
    cgcreate -g "$cgroups_v1:/$id"
  fi
}

function _cg_set() { # <id>
  local id=$1
  : "${SHOCKER_CPU_SHARE:=1024}"
  : "${SHOCKER_MEM_LIMIT:=512}" # MiB
  if [[ $CGROUP_VERSION -eq 2 ]]; then
    # cgroupsv2: cpu.weight 1-10000 (roughly maps from v1 shares 2-262144)
    local weight=$(( SHOCKER_CPU_SHARE * 10000 / 262144 ))
    [[ $weight -lt 1 ]] && weight=1
    echo "$weight"                          > /sys/fs/cgroup/"$id"/cpu.weight
    echo "$((SHOCKER_MEM_LIMIT * 1048576))" > /sys/fs/cgroup/"$id"/memory.max
  elif [[ $CGROUP_VERSION -eq 1 ]]; then
    cgset -r cpu.shares="$SHOCKER_CPU_SHARE"                          "$id"
    cgset -r memory.limit_in_bytes="$((SHOCKER_MEM_LIMIT * 1048576))" "$id"
  fi
}

function _cg_exec() { # <id> <cmd…>
  local id=$1; shift
  if [[ $CGROUP_VERSION -eq 2 ]]; then
    # Write shell PID into cgroup, then exec (cgexec not available for v2)
    # $1=cgroup.procs path, ${@:2}=actual command — exec preserves all quoting
    local cgroot=/sys/fs/cgroup/"$id"
    bash -c 'echo $$ > "$1" && exec "${@:2}"' -- "${cgroot}/cgroup.procs" "$@"
  elif [[ $CGROUP_VERSION -eq 1 ]]; then
    cgexec -g "$cgroups_v1:$id" "$@"
  else
    exec "$@"
  fi
}

function _cg_delete() { # <id>
  local id=$1
  if [[ $CGROUP_VERSION -eq 2 ]]; then
    rmdir /sys/fs/cgroup/"$id" 2>/dev/null || true
  elif [[ $CGROUP_VERSION -eq 1 ]]; then
    cgdelete -g "$cgroups_v1:/$id" 2>/dev/null || true
  fi
}

# ── commands ─────────────────────────────────────────────────────────────────

function shocker_init() { #HELP Create an image from a directory:\nSHOCKER init <directory>
  local uuid="img-$(_uuid)"
  if [[ -d "$1" ]]; then
    [[ "$(shocker_check "$uuid")" == 0 ]] && shocker_run "$@"
    btrfs subvolume create "$btrfs_path/$uuid" > /dev/null
    cp -rf --reflink=auto "$1"/* "$btrfs_path/$uuid" > /dev/null
    mkdir -p "$btrfs_path/$uuid/shocker"
    [[ ! -f "$btrfs_path/$uuid/shocker/source" ]] && echo "$1" > "$btrfs_path/$uuid/shocker/source"
    echo "Created: $uuid"
  else
    echo "No directory named '$1' exists" && exit 1
  fi
}

function shocker_pull() { #HELP Pull an image from Docker Hub (v2 API):\nSHOCKER pull <name[:tag]>
  # SHOCKER_REGISTRY=host:port  — pull-through mirror or private registry.
  # SHOCKER_REGISTRY_USER / SHOCKER_REGISTRY_PASS — credentials when the registry
  #   issues a Bearer auth challenge (e.g. registry.example.com via git.example.com JWT).
  # HTTP is assumed for non-443 ports; Docker Hub is used when SHOCKER_REGISTRY is unset.
  local name tag
  if [[ "$1" == *:* ]]; then
    name="${1%%:*}" tag="${1##*:}"
  else
    name="$1" tag="${2:-latest}"
  fi
  local display="${name}:${tag}"
  # Resolve official images (e.g. "alpine") to library/alpine
  [[ "$name" != */* ]] && name="library/$name"

  local registry token=''
  local -a auth_hdr=()   # populated only when using Docker Hub token auth

  if [[ -n "${SHOCKER_REGISTRY:-}" ]]; then
    # Mirror or private registry: HTTP for non-443 ports, HTTPS otherwise
    local scheme='https'
    local port="${SHOCKER_REGISTRY##*:}"
    [[ "$SHOCKER_REGISTRY" == *:* && "$port" != "443" ]] && scheme='http'
    registry="${scheme}://${SHOCKER_REGISTRY}/v2"
    # Probe for auth challenge (registry.example.com, self-hosted gitlabs might use Bearer JWT auth)
    local www_auth
    www_auth="$(curl -sI "$registry/$name/manifests/$tag" 2>/dev/null \
      | grep -i '^www-authenticate:' | head -1 || true)"
    if [[ -n "$www_auth" ]]; then
      local realm svc scope
      realm="$(echo "$www_auth" | grep -o 'realm="[^"]*"' | cut -d'"' -f2)"
      svc="$(echo  "$www_auth" | grep -o 'service="[^"]*"' | cut -d'"' -f2)"
      scope="repository:${name}:pull"
      local -a cred_args=()
      [[ -n "${SHOCKER_REGISTRY_USER:-}" ]] \
        && cred_args=(-u "${SHOCKER_REGISTRY_USER}:${SHOCKER_REGISTRY_PASS:-}")
      token="$(curl -fsSL "${cred_args[@]}" \
        "${realm}?service=${svc}&scope=${scope}" \
        | jq -r '.token // .access_token // empty' 2>/dev/null || true)"
      [[ -n "$token" ]] && auth_hdr=(-H "Authorization: Bearer $token")
    fi
  else
    # Docker Hub: obtain a bearer token first
    registry='https://registry-1.docker.io/v2'
    token="$(curl -fsSL \
      "https://auth.docker.io/token?service=registry.docker.io&scope=repository:${name}:pull" \
      | grep -o '"token":"[^"]*"' | cut -d'"' -f4)"
    [[ -z "$token" ]] && echo "Failed to authenticate for '$name'" && exit 1
    auth_hdr=(-H "Authorization: Bearer $token")
  fi

  local arch; arch="$(uname -m)"
  # Normalise arch to OCI/Docker naming
  case "$arch" in
    x86_64)  arch='amd64' ;;
    aarch64) arch='arm64' ;;
    armv7l)  arch='arm'   ;;
    i?86)    arch='386'   ;; # eg: iSH on iOS
  esac

  # Fetch manifest — may be a manifest list (multi-arch index) or a single manifest
  local manifest
  manifest="$(curl -fsSL \
    ${auth_hdr[@]+"${auth_hdr[@]}"} \
    -H 'Accept: application/vnd.docker.distribution.manifest.list.v2+json' \
    -H 'Accept: application/vnd.oci.image.index.v1+json' \
    -H 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
    -H 'Accept: application/vnd.oci.image.manifest.v1+json' \
    "$registry/$name/manifests/$tag")"
  # Detect manifest list / OCI image index by the presence of a top-level "manifests" array
  # (don't grep mediaType — the inner per-manifest entries appear first and fool head -1)
  local is_index
  is_index="$(echo "$manifest" | jq -r 'has("manifests")' 2>/dev/null)"

  # If we got a manifest list / image index, resolve to the right platform manifest
  if [[ "$is_index" == "true" ]]; then
    # Find the digest for our platform (match arch, prefer linux os)
    local target_digest
    target_digest="$(echo "$manifest" | jq -r --arg arch "$arch" '[.manifests[]
      | select(.platform.architecture == $arch and (.platform.os // "linux") == "linux")][0].digest
      // empty' 2>/dev/null)"
    [[ -z "$target_digest" ]] && echo "No image for arch '$arch' in '$name:$tag'" && exit 1
    manifest="$(curl -fsSL \
      ${auth_hdr[@]+"${auth_hdr[@]}"} \
      -H 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
      -H 'Accept: application/vnd.oci.image.manifest.v1+json' \
      "$registry/$name/manifests/$target_digest")"
  fi

  # Extract only layer digests (exclude the config blob which is not a tarball)
  local layers
  layers="$(echo "$manifest" | jq -r '.layers[]?.digest' 2>/dev/null)"
  [[ -z "$layers" ]] && echo "No image '$name:$tag' found or unsupported manifest" && exit 1

  # Create btrfs subvolume up front; pipe each layer blob directly into tar — zero /tmp usage.
  # SHOCKER_DEST bypasses btrfs and unpacks straight into a plain directory instead.
  local uuid dest
  if [[ -n "${SHOCKER_DEST:-}" ]]; then
    dest="$SHOCKER_DEST"
    # Re-pulling the same dest should reflect the image as-is, not accumulate stale
    # files from a previous pull whose layers no longer include them.
    [[ -e "$dest" ]] && read -rp "[RETURN] to replace existing '$dest' (Ctrl-C to abort)... "
    rm -rf "$dest"
    mkdir -p "$dest"
  else
    uuid="img-$(_uuid)"
    dest="$btrfs_path/$uuid"
    btrfs subvolume create "$dest" > /dev/null
  fi
  mkdir -p "$dest/shocker"

  while IFS= read -r digest; do
    echo "Pulling layer ${digest:7:19}…"
    if [[ -z "${SHOCKER_REGISTRY:-}" ]]; then
      local cdn_url
      cdn_url="$(curl -sw '%{redirect_url}' -o /dev/null \
        ${auth_hdr[@]+"${auth_hdr[@]}"} \
        "$registry/$name/blobs/$digest")"
      if [[ -n "$cdn_url" ]]; then
        curl -fsSL "$cdn_url" \
          || { echo "Layer download failed. Set SHOCKER_REGISTRY to a pull-through mirror." && exit 1; }
      else
        curl -fsSL ${auth_hdr[@]+"${auth_hdr[@]}"} "$registry/$name/blobs/$digest"
      fi
    else
      curl -fsSL ${auth_hdr[@]+"${auth_hdr[@]}"} "$registry/$name/blobs/$digest"
    fi | tar xzf - -C "$dest"
  done <<< "$layers"

  # Persist ENTRYPOINT+CMD+WORKDIR from the image config blob
  local config_digest
  config_digest="$(echo "$manifest" | jq -r '.config.digest // empty' 2>/dev/null || true)"
  if [[ -n "$config_digest" ]]; then
    local config
    config="$(curl -fsSL ${auth_hdr[@]+"${auth_hdr[@]}"} "$registry/$name/blobs/$config_digest" 2>/dev/null)" || true
    {
      jq -c '(.config.Entrypoint // []) + (.config.Cmd // [])' <<< "$config" > "$dest/shocker/entrypoint"
      jq -j '.config.WorkingDir // ""'                         <<< "$config" > "$dest/shocker/workdir"
      jq -r '(.config.Env // [])[]'                            <<< "$config" > "$dest/shocker/env"
    } 2>/dev/null || true
  fi

  if [[ -z "${SHOCKER_DEST:-}" ]]; then
    local -a _src_files=("$btrfs_path"/img-*/shocker/source)
    [[ ${#_src_files[@]} -gt 0 ]] && \
      grep -lx "$display" "${_src_files[@]}" 2>/dev/null \
        | grep -v "/$uuid/shocker/source" \
        | xargs -r -I{} sh -c 'echo _none_ > "{}"'
  fi
  echo "$display" > "$dest/shocker/source"
  echo "Created: ${uuid:-$dest}"
}

function shocker_rm() { #HELP Delete an image or container:\nSHOCKER rm <image_id or container_id>
  [[ "$(shocker_check "$1")" == 1 ]] && echo "No container named '$1' exists" && exit 1
  btrfs subvolume delete "$btrfs_path/$1" > /dev/null
  _cg_delete "$1"
  echo "Removed: $1"
}

function shocker_images() { #HELP List images:\nSHOCKER images
  echo -e "IMAGE_ID\t\tSOURCE"
  for img in "$btrfs_path"/img-*; do
    img=$(basename "$img")
    echo -e "$img\t\t$(cat "$btrfs_path/$img/shocker/source")"
  done
}

function shocker_ps() { #HELP List containers:\nSHOCKER ps
  echo -e "CONTAINER_ID\t\tCOMMAND"
  for ps in "$btrfs_path"/ps-*; do
    ps=$(basename "$ps")
    echo -e "$ps\t\t$(cat "$btrfs_path/$ps/$ps.cmd")"
  done
}

function shocker_run() { #HELP Create a container:\nSHOCKER run [-it] [--rm] [-v src[:dst]] [-e VAR=val] <image_id | directory> [command]
  # Parse flags
  local interactive=0 do_rm=0
  local -a volumes=() env_vars=()
  while [[ "${1:-}" == -* ]]; do
    case "$1" in
      -i|-t|-it|-ti) interactive=1 ;;
      --rm) do_rm=1 ;;
      -v) volumes+=("$2"); shift ;;
      -e) env_vars+=("$2"); shift ;;
      *) echo "Unknown flag: $1" && exit 1 ;;
    esac
    shift
  done

  local img="$1" meta
  if [[ -d "$img" ]]; then
    # Plain dir (eg: from `shocker --dest=mydir pull ..`): no btrfs/netns/cgroups needed
    meta="$img/shocker"
  else
    btrfs_check
    # Allow "alpine" or "alpine:latest" — look up img-XXXXX by img.source content
    if [[ "$img" != img-* && "$img" != ps-* ]]; then
      local search="$img"; [[ "$img" != *:* ]] && search="$img:latest"
      img=$(grep -rlx "$search" "$btrfs_path"/img-*/shocker/source 2>/dev/null \
            | head -1 | sed 's|.*/\(img-[^/]*\)/.*|\1|') || true
      [[ -z "$img" ]] && echo "No image named '$1' exists" && exit 1
    fi
    [[ "$(shocker_check "$img")" == 1 ]] && echo "No image named '$img' exists" && exit 1
    meta="$btrfs_path/$img/shocker"
  fi

  local -a cmd_args=("${@:2}") # this is command plus all args
  [[ ${#cmd_args[@]} -eq 0 && $interactive -eq 1 ]] && cmd_args=('/bin/sh')
  if [[ ${#cmd_args[@]} -eq 0 ]]; then
    local ep_file="$meta/entrypoint"
    [[ -f "$ep_file" ]] && mapfile -t cmd_args < <(jq -r '.[]' "$ep_file") 2>/dev/null || true
    [[ ${#cmd_args[@]} -eq 0 ]] && echo "No command specified (and image has no ENTRYPOINT/CMD)" && exit 1
  fi
  local workdir='/'
  local wd_file="$meta/workdir"
  [[ -f "$wd_file" ]] && workdir="$(cat "$wd_file")"
  [[ -z "$workdir" ]] && workdir='/'
  local -a img_env=()
  local env_file="$meta/env"
  [[ -f "$env_file" ]] && mapfile -t img_env < "$env_file"
  cmd_args=("env" "-i" "${img_env[@]}" "${env_vars[@]}" "${cmd_args[@]}")

  if [[ -d "$img" ]]; then
    # Runs in place (changes persist; --rm ignored) w/ host networking.  Uses unshare if it works.
    mkdir -p "$img/etc" && cp /etc/resolv.conf "$img/etc/resolv.conf"
    local -a ns=(unshare -fmuip --propagation unchanged)
    # subshell keeps bash's "Bad system call" notice quiet (iSH has no unshare syscall)
    ( "${ns[@]}" true && exit 0; exit 1 ) 2>/dev/null || ns=()
    nsroot="$img" nvols="${#volumes[@]}" workdir="$workdir" \
      ${ns[@]+"${ns[@]}"} /bin/sh -c "$_ns_script" -- ${volumes[@]+"${volumes[@]}"} "${cmd_args[@]}" || true
    # no mount namespace => our /dev & /proc mounts landed on the host; undo them
    [[ ${#ns[@]} -eq 0 ]] && { umount "$img/proc" "$img/dev" 2>/dev/null || true; }
    return
  fi

  # One-time bridge + NAT setup (survives until reboot; harmless if already exists)
  if ! ip link show bridge0 &>/dev/null; then
    ip link add name bridge0 type bridge
    ip addr add 10.0.0.1/24 dev bridge0
    ip link set bridge0 up
    echo 1 > /proc/sys/net/ipv4/ip_forward
    iptables -t nat -A POSTROUTING -s 10.0.0.0/24 ! -o bridge0 -j MASQUERADE
  fi
  # Ensure FORWARD rules exist (survive reboots; idempotent via -C check)
  iptables -C FORWARD -i bridge0 -j ACCEPT &>/dev/null \
    || iptables -I FORWARD -i bridge0 -j ACCEPT
  iptables -C FORWARD -o bridge0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT &>/dev/null \
    || iptables -I FORWARD -o bridge0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

  # UUID conflict: loop rather than recurse (recursion would lose parsed flags)
  local uuid
  while true; do
    uuid="ps-$(_uuid)"
    [[ "$(shocker_check "$uuid")" == 1 ]] && break
    echo "UUID conflict, retrying…"
  done

  # Derive IP from full 5-hex-digit UUID value (1–253) to minimize collision
  local hex="${uuid#ps-}"
  local suffix; suffix=$(( 16#${hex} % 253 + 1 ))
  local ip="10.0.0.$suffix"
  # Proper 6-octet MAC: fixed OUI 02:42 + 4 hex digits zero-padded from UUID
  local u8; u8="$(printf '%08x' "$((16#${hex}))")"
  local mac="02:42:${u8:0:2}:${u8:2:2}:${u8:4:2}:${u8:6:2}"

  ip link add dev veth0_"$uuid" type veth peer name veth1_"$uuid"
  ip link set dev veth0_"$uuid" up
  ip link set veth0_"$uuid" master bridge0
  ip netns add netns_"$uuid"
  ip link set veth1_"$uuid" netns netns_"$uuid"
  nsenter --net=/run/netns/netns_"$uuid" ip link set dev lo up
  nsenter --net=/run/netns/netns_"$uuid" ip link set veth1_"$uuid" address "$mac"
  nsenter --net=/run/netns/netns_"$uuid" ip addr add "$ip/24" dev veth1_"$uuid"
  nsenter --net=/run/netns/netns_"$uuid" ip link set dev veth1_"$uuid" up
  nsenter --net=/run/netns/netns_"$uuid" ip route add default via 10.0.0.1

  local root="$btrfs_path/$uuid"

  btrfs subvolume snapshot "$btrfs_path/$img" "$root" > /dev/null
  mkdir -p "$root/etc"

  # use host DNS resolving
  cp /etc/resolv.conf "$root/etc/resolv.conf"

  echo "${cmd_args[*]}" > "$root/$uuid.cmd"

  _cg_create "$uuid"
  _cg_set    "$uuid"

  local -a all_vols=("${volumes[@]}")
  if [[ $interactive -eq 1 ]]; then
    _run_ns "$uuid" "$root" "${#all_vols[@]}" "$workdir" "${all_vols[@]}" "${cmd_args[@]}" || true
  else
    _run_ns "$uuid" "$root" "${#all_vols[@]}" "$workdir" "${all_vols[@]}" "${cmd_args[@]}" \
      2>&1 | tee "$root/$uuid.log" || true
  fi

  ip link del dev veth0_"$uuid"
  ip netns del netns_"$uuid"

  [[ $do_rm -eq 1 ]] && shocker_rm "$uuid" > /dev/null
}
# Runs inside the new mount namespace (if any).  env: nsroot nvols workdir.  args: [vol…] <cmd…>
_ns_script='
  mount -t devtmpfs devtmpfs "$nsroot/dev" 2>/dev/null || mount --bind /dev "$nsroot/dev" 2>/dev/null
  mount -n -t proc proc "$nsroot/proc" 2>/dev/null
  i=0; while [ "$i" -lt "$nvols" ]; do
    volarg=$1; shift; i=$((i+1))
    src="${volarg%%:*}" dst="${volarg#*:}"
    if [ -d "$src" ]; then mkdir -p "$nsroot$dst"
    else mkdir -p "$(dirname "$nsroot$dst")" && touch "$nsroot$dst"; fi
    mount --bind "$src" "$nsroot$dst" 2>/dev/null || echo "warning: could not mount -v $volarg" >&2
  done
  exec chroot "$nsroot" /bin/sh -c "cd \"$workdir\" && exec \"\$@\"" -- "$@"
'
function _run_ns() { # <uuid> <root> <nvols> <workdir> [vol…] <cmd…>
  local uuid=$1 nsroot=$2 nvols=$3 workdir=$4; shift 4
  nsroot="$nsroot" nvols="$nvols" workdir="$workdir" \
  _cg_exec "$uuid" \
    nsenter --net=/run/netns/netns_"$uuid" \
      unshare -fmuip --propagation unchanged \
        /bin/sh -c "$_ns_script" -- "$@"
}

function shocker_exec() { #HELP Execute a command in a running container:\nSHOCKER exec <container_id> <command>
  [[ "$(shocker_check "$1")" == 1 ]] && echo "No container named '$1' exists" && exit 1
  # Find the unshare process that owns this container's namespace
  local cid
  cid="$(ps -eo pid,args \
    | awk -v u="$1" '$0 ~ "unshare.*"u {print $1}' \
    | head -1)"
  [[ -z "$cid" ]] && echo "Container '$1' exists but is not running" && exit 1
  nsenter -t "$cid" -m -u -i -n -p chroot "$btrfs_path/$1" "${@:2}"
}

function shocker_logs() { #HELP View logs from a container:\nSHOCKER logs <container_id>
  [[ "$(shocker_check "$1")" == 1 ]] && echo "No container named '$1' exists" && exit 1
  cat "$btrfs_path/$1/$1.log"
}

function shocker_commit() { #HELP Commit a container to an image:\nSHOCKER commit <container_id> <image_id>
  [[ "$(shocker_check "$1")" == 1 ]] && echo "No container named '$1' exists" && exit 1
  [[ "$(shocker_check "$2")" == 1 ]] && echo "No image named '$2' exists" && exit 1
  shocker_rm "$2" && btrfs subvolume snapshot "$btrfs_path/$1" "$btrfs_path/$2" > /dev/null
  echo "Created: $2"
}

function shocker_help() { #HELP Display this message:\nSHOCKER help
  grep '^function.*#HELP' "$1" | sed "s/^.*#HELP //;s/\\\\n/\n\t/g;s/$/\n/;s!SHOCKER!${1/!/\\!}!g"
}

# ── dispatch ─────────────────────────────────────────────────────────────────

[[ -z "${1-}" ]] && shocker_help "$0" && exit 0

case $1 in
  pull|init|rm|images|ps|exec|logs|commit) btrfs_check; shocker_"$1" "${@:2}" ;;
  run) shocker_run "${@:2}" ;; # does its own btrfs_check (unless running a plain dir)
  *) shocker_help "$0" ;;
esac
